# ─────────────────────────────────────────────────────────────────
# ADAS Configuration — Environment Variable Overrides
# Copy to .env and modify as needed.
# All variables are prefixed with ADAS_
# ─────────────────────────────────────────────────────────────────

# General
ADAS_DEVICE=cpu                  # cpu | cuda | mps (auto-detected if not set)
ADAS_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
ADAS_MAX_UPLOAD_MB=500

# Preprocessing
ADAS_TARGET_WIDTH=1280
ADAS_TARGET_HEIGHT=720
ADAS_CLAHE_CLIP_LIMIT=2.0
ADAS_USE_ADAPTIVE_CANNY=true

# Vehicle Detection
ADAS_YOLO_CONF=0.4
ADAS_YOLO_IOU=0.45

# Tracker
ADAS_IOU_THRESHOLD=0.25
ADAS_MAX_AGE=8
ADAS_USE_KALMAN=true

# Distance
ADAS_FOCAL_LENGTH=850.0
ADAS_CAMERA_HEIGHT_M=1.3

# FCW
ADAS_TTC_BRAKE=1.5
ADAS_TTC_CAUTION=3.0
ADAS_EGO_SPEED_DEFAULT=60.0
ADAS_FCW_HYSTERESIS_FRAMES=3

# Server
ADAS_API_HOST=0.0.0.0
ADAS_API_PORT=8000
